# =========================
# ESP-IDF / C / Build output
# =========================

# Prerequisites
*.d

# Object files / binaries
*.o
*.obj
*.elf
*.map
*.hex
*.bin
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app

# Debug / symbols
*.dSYM/
*.su
*.idb
*.pdb
*.dwo

# =========================
# ESP-IDF specific
# =========================

# Build folders (default esp-idf)
build/
**/build/
.cache/

# CMake / Ninja generated
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
build.ninja
.ninja_deps
.ninja_log
rules.ninja

# ESP-IDF managed components (auto-downloaded)
managed_components/
**/managed_components/

# Python virtualenvs (common in esp-idf projects)
.venv/
venv/
env/
pytest_hello_world.py

# IDE / editor
.vscode/
.idea/
*.code-workspace

# OS junk
.DS_Store
Thumbs.db

# Serial logs / misc
*.log

# =========================
# Optional: local sdkconfig overrides (keep sdkconfig itself tracked)
# =========================
sdkconfig.old
sdkconfig.defaults
sdkconfig.defaults.*
sdkconfig.ci
sdkconfig.local
sdkconfig.local.*
